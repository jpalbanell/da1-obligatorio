@page "/partidos/{Id:int}/editar"
@using Dominio.Entidades
@using IServicios
@using Web.DTOs
@inject ITorneoServicio TorneoServicio
@inject ISesionServicio SesionServicio
@inject NavigationManager Nav



@if (!_cargado)
{
    <p>Cargando...</p>
    return;
}

@if (!_usuarioActual.TieneRol(Rol.Editor))
{
    <p>No tenés permisos para ver esta página.</p>
    return;
}

@if (_partido == null)
{
    <p>Partido no encontrado.</p>
    return;
}

@if (_partido.EstaBloqueado)
{
    <p>Este partido está bloqueado y no se puede editar.</p>
    <button class="btn btn-secondary" @onclick="Volver">Volver</button>
    return;
}

<h3>Editar Partido @_partido.Codigo</h3>
<p><strong>@(_partido.EquipoLocal?.Nombre ?? "Por definir")</strong> vs <strong>@(_partido.EquipoVisitante?.Nombre ?? "Por definir")</strong></p>

@if (!string.IsNullOrEmpty(_mensajeError))
{
    <div class="alert alert-danger">@_mensajeError</div>
}

@if (!string.IsNullOrEmpty(_mensajeExito))
{
    <div class="alert alert-success">@_mensajeExito</div>
}

<EditForm Model="_form" OnValidSubmit="Guardar" FormName="EditarPartidoForm">
    <div class="mb-3">
        <label class="form-label">Fecha</label>
        <InputDate class="form-control" @bind-Value="_form.Fecha" />
    </div>

    <div class="mb-3">
        <label class="form-label">Estadio</label>
        <InputSelect class="form-select" @bind-Value="_form.EstadioNombre">
            <option value="">-- Seleccionar --</option>
            @foreach (var estadio in _estadios)
            {
                <option value="@estadio.Nombre">@estadio.Nombre</option>
            }
        </InputSelect>
    </div>

    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="_form.CargarResultado" />
        <label class="form-check-label">Cargar resultado</label>
    </div>

    @if (_form.CargarResultado)
    {
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Goles @(_partido.EquipoLocal?.Nombre ?? "Por definir")</label>

                <InputNumber class="form-control" @bind-Value="_form.GolesLocal" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Goles @(_partido.EquipoVisitante?.Nombre ?? "Por definir")</label>
                <InputNumber class="form-control" @bind-Value="_form.GolesVisitante" />
            </div>
        </div>
    }

    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="_form.CargarIncidencias" />
        <label class="form-check-label">Cargar incidencias</label>
    </div>

    @if (_form.CargarIncidencias)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title">Tarjetas</h6>
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label">Amarillas @(_partido.EquipoLocal?.Nombre ?? "Local")</label>
                        <InputNumber class="form-control" @bind-Value="_form.TarjetasAmarillasLocal" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Rojas @(_partido.EquipoLocal?.Nombre ?? "Local")</label>
                        <InputNumber class="form-control" @bind-Value="_form.TarjetasRojasLocal" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label">Amarillas @(_partido.EquipoVisitante?.Nombre ?? "Visitante")</label>
                        <InputNumber class="form-control" @bind-Value="_form.TarjetasAmarillasVisitante" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Rojas @(_partido.EquipoVisitante?.Nombre ?? "Visitante")</label>
                        <InputNumber class="form-control" @bind-Value="_form.TarjetasRojasVisitante" />
                    </div>
                </div>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary">Guardar</button>
    <button type="button" class="btn btn-secondary" @onclick="Volver">Cancelar</button>
</EditForm>

@code {
    [Parameter] public int Id { get; set; }
    private bool _cargado = false;
    private Usuario? _usuarioActual;
    private Partido? _partido;
    private List<Estadio> _estadios = new();
    private EditarPartidoRequest _form = new();
    private string _mensajeError = "";
    private string _mensajeExito = "";

    protected override void OnInitialized()
    {
        _usuarioActual = SesionServicio.ObtenerUsuarioActual();
        if (_usuarioActual == null)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _partido = TorneoServicio.ObtenerPartido(Id);
        if (_partido != null)
        {
            _form = EditarPartidoRequest.FromEntity(_partido);
            _estadios = TorneoServicio.ObtenerTodosEstadios();
        }

        _cargado = true;
    }

    private void Guardar()
    {
        try
        {
            List<Incidencia>? incidencias = null;
            if (_form.CargarIncidencias && _partido!.TieneEquiposCompletos())
            {
                incidencias = new List<Incidencia>();
                if (_form.TarjetasAmarillasLocal > 0)
                    incidencias.Add(new Incidencia { Tipo = TipoIncidencia.TarjetaAmarilla, Equipo = _partido.EquipoLocal, Cantidad = _form.TarjetasAmarillasLocal });
                if (_form.TarjetasRojasLocal > 0)
                    incidencias.Add(new Incidencia { Tipo = TipoIncidencia.TarjetaRoja, Equipo = _partido.EquipoLocal, Cantidad = _form.TarjetasRojasLocal });
                if (_form.TarjetasAmarillasVisitante > 0)
                    incidencias.Add(new Incidencia { Tipo = TipoIncidencia.TarjetaAmarilla, Equipo = _partido.EquipoVisitante, Cantidad = _form.TarjetasAmarillasVisitante });
                if (_form.TarjetasRojasVisitante > 0)
                    incidencias.Add(new Incidencia { Tipo = TipoIncidencia.TarjetaRoja, Equipo = _partido.EquipoVisitante, Cantidad = _form.TarjetasRojasVisitante });
            }

            TorneoServicio.EditarPartido(
                _partido!.Id,
                _form.Fecha,
                _form.EstadioNombre,
                _form.CargarResultado,
                _form.GolesLocal,
                _form.GolesVisitante,
                incidencias);

            _mensajeExito = "Partido modificado correctamente.";
            _mensajeError = "";
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
            _mensajeExito = "";
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/partidos");
    }
}