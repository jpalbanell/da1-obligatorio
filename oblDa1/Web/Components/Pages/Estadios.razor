@page "/estadios"
@using Dominio.Entidades
@using IServicios
@using Web.DTOs
@inject IEstadioServicio EstadioServicio
@inject ISesionServicio SesionServicio
@inject NavigationManager Nav


@if (!_cargado)
{
    <p>Cargando...</p>
}
else if (!_usuarioActual.TieneRol(Rol.Administrador))
{
    <p>No tenés permisos para ver esta página.</p>
}
else
{
    <h3>Estadios</h3>
    @if (!string.IsNullOrEmpty(_mensajeExito))
    {
        <div class="alert alert-success">@_mensajeExito</div>
    }
    <button class="btn btn-primary mb-3" @onclick="AbrirModal">+ Agregar estadio</button>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Nombre</th>
            <th>Ciudad</th>
            <th>Capacidad</th>
            <th>Descripción</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var estadio in _estadios)
        {
            <tr>
                <td>@estadio.Nombre</td>
                <td>@estadio.Ciudad</td>
                <td>@estadio.Capacidad</td>
                <td>@estadio.Descripcion</td>
                <td>
                    <button class="btn btn-sm btn-outline-secondary" 
                            @onclick="() => AbrirModalEditar(estadio)">
                        Editar
                    </button>
                    <button class="btn btn-sm btn-outline-danger ms-1"
                            @onclick="() => Eliminar(estadio.Nombre)">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (_mostrarModal)
    {
        <div class="modal show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(_modoEdicion ? "Editar estadio" : "Agregar estadio")</h5>
                        <button class="btn-close" @onclick="CerrarModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(_mensajeError))
                        {
                            <div class="alert alert-danger">@_mensajeError</div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input class="form-control" @bind="_form.Nombre"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ciudad</label>
                            <input class="form-control" @bind="_form.Ciudad"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Capacidad (mín. 20.000)</label>
                            <input type="number" class="form-control" @bind="_form.Capacidad"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción (opcional)</label>
                            <textarea class="form-control" @bind="_form.Descripcion" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }

    @code {
        private Usuario _usuarioActual;
        private List<EstadioResponse> _estadios = new();
        private EstadioRequest _form = new();
        private string _mensajeError = "";
        private string _mensajeExito = "";
        private bool _modoEdicion = false;
        private string _nombreOriginal = "";
        private bool _mostrarModal = false;
        private bool _cargado = false;

        protected override void OnInitialized()
        {
            _usuarioActual = SesionServicio.ObtenerUsuarioActual();
            if (_usuarioActual == null)
            {
                Nav.NavigateTo("/login");
                return;
            }
            _estadios = EstadioServicio.ObtenerTodos()
                .Select(EstadioResponse.FromEntity)
                .ToList();
            _cargado = true;
        }

        private void AbrirModal()
        {
            _form = new EstadioRequest();
            _modoEdicion = false;
            _mensajeError = "";
            _mostrarModal = true;
        }

        private void CerrarModal()
        {
            _mostrarModal = false;
        }

        private void Guardar()
        {
            try
            {
                var estadio = _form.ToEntity();
                if (_modoEdicion)
                    EstadioServicio.ModificarEstadio(estadio, _nombreOriginal);
                else
                    EstadioServicio.AgregarEstadio(estadio);

                _estadios = EstadioServicio.ObtenerTodos()
                    .Select(EstadioResponse.FromEntity)
                    .ToList();
                CerrarModal();
                _mensajeExito = _modoEdicion ? "Estadio editado correctamente." : "Estadio agregado correctamente.";
                _form = new EstadioRequest();
                _modoEdicion = false;
            }
            catch (Exception ex)
            {
                _mensajeError = ex.Message;
            }
        }
        private void AbrirModalEditar(EstadioResponse estadio)
        {
            _form = new EstadioRequest
            {
                Nombre = estadio.Nombre,
                Ciudad = estadio.Ciudad,
                Capacidad = estadio.Capacidad,
                Descripcion = estadio.Descripcion
            };
            _nombreOriginal = estadio.Nombre;
            _modoEdicion = true;
            _mensajeError = "";
            _mostrarModal = true;
        }
        private void Eliminar(string nombre)
        {
            try
            {
                EstadioServicio.EliminarEstadio(nombre);
                _estadios = EstadioServicio.ObtenerTodos()
                    .Select(EstadioResponse.FromEntity)
                    .ToList();
                _mensajeExito = "Estadio eliminado correctamente.";
            }
            catch (Exception ex)
            {
                _mensajeError = ex.Message;
            }
        }
    }
}
